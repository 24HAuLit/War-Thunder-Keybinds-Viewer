    gm_sight_distance{
      mouseAxisId:i=3
    }

    gm_zoom{
      mouseAxisId:i=-1
    }

    human_uav_pitch{
      innerDeadzone:r=0
      nonlinearity:r=1
    }

    human_uav_roll{
      innerDeadzone:r=0
      nonlinearity:r=1
    }

    human_uav_throttle{
      mouseAxisId:i=7
      innerDeadzone:r=0.02
    }
  }

